FROM python:3.11-slim

WORKDIR /ai-service

# requirements 먼저 복사 후 설치
COPY ai-service/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# logs 디렉토리 미리 생성
RUN mkdir -p logs

# 나머지 전체 복사
COPY ai-service/ .

# 포트 오픈
EXPOSE 8000

# uvicorn 실행
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
