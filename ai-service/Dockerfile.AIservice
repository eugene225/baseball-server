FROM python:3.11-slim

WORKDIR /ai-service

RUN apt update && apt install -y --no-install-recommends \
    wget \
    libnss3 \
    libxi6 \
    libxcomposite1 \
    libxcursor1 \
    libxdamage1 \
    libatk-bridge2.0-0 \
    libdrm2 \
    libgbm1 \
    libxrandr2 \
    xdg-utils \
    fonts-liberation \
    libappindicator3-1 \
    libasound2 \
    libatk1.0-0 \
    libcups2 \
    libxss1 \
    lsb-release \
    && rm -rf /var/lib/apt/lists/*

COPY ai-service/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY ai-service/ .

RUN mkdir -p logs /usr/bin/chrome /usr/bin/chromedriver

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
